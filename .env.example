# Supabase (opcional). Sin estas variables el HUB guarda todo en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Jarvis (asistente). Clave gratis de Gemini (aistudio.google.com/apikey) y el id de usuario dueño del HUB.
GEMINI_API_KEY=xxxxxxxx
# Opcional: otro modelo de Gemini (por defecto gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
HUB_OWNER_ID=00000000-0000-0000-0000-000000000000

# Optional: Gemini voice for Jarvis (defaults: gemini-2.5-flash-preview-tts, voice Charon)
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
