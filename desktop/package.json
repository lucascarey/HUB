{
  "name": "jarvis-escritorio",
  "productName": "Jarvis",
  "version": "0.1.2",
  "description": "Jarvis, el compañero de escritorio del HUB",
  "author": "Lucas Carey",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "msedge-tts": "2.1.1"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.hub.jarvis",
    "productName": "Jarvis",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "preload.cjs", "offline.html", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Jarvis"
    }
  }
}
